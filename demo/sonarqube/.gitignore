# ============================================
# .gitignore para la demo de SonarQube
# ============================================

# Dependencias de Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Variables de entorno (contienen tokens sensibles)
.env
.env.local
.env.*.local

# SonarQube / SonarScanner
.sonar/
.scannerwork/
.sonarqube/
sonar-scanner-*/

# Proyecto demo clonado (OWASP NodeGoat)
# El usuario clona este repositorio localmente; no se sube al git
demo/sonarqube/nodegoat/

# IDE y editores
.vscode/
.idea/
*.swp
*.swo

# Sistema operativo
.DS_Store
Thumbs.db

# ============================================
# .gitignore - SAST IsraelStarTeam
# ============================================

# Dependencias de Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Variables de entorno (contienen tokens y secretos sensibles)
.env
.env.local
.env.*.local

# SonarQube / SonarScanner
.sonar/
.scannerwork/
.sonarqube/

# Proyecto demo clonado (OWASP NodeGoat)
# Se clona localmente para la demo; no se sube al repositorio
demo/sonarqube/nodegoat/

# IDE y editores
.vscode/
.idea/
*.swp
*.swo

# Sistema operativo
.DS_Store
Thumbs.db
